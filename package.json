{
  "name": "dotenv-lens",
  "displayName": "DotEnv Lens",
  "description": "Inspect .env files. Compare a .env with its template, and hover over process.env to see values.",
  "version": "0.2.0",
  "publisher": "venkatarohithpesala",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/venkatarohithpesala/dotenv-lens.git"
  },
  "bugs": {
    "url": "https://github.com/venkatarohithpesala/dotenv-lens/issues"
  },
  "homepage": "https://github.com/venkatarohithpesala/dotenv-lens#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "env",
    "dotenv",
    "compare",
    "diff",
    "hover",
    "process.env"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "contributes": {
    "configuration": {
      "title": "DotEnv Lens",
      "properties": {
        "dotenvlens.maskSecrets": {
          "type": "boolean",
          "default": false,
          "description": "Mask the values of secret-looking keys (KEY, SECRET, TOKEN, PASSWORD) and passwords inside connection URLs when hovering over process.env. Useful when sharing your screen."
        }
      }
    },
    "commands": [
      {
        "command": "dotenvlens.compare",
        "title": "Compare .env with template",
        "category": "DotEnv Lens"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "dotenvlens.compare",
          "when": "resourceFilename =~ /^\\.env(\\.local|\\.template|\\.example|\\.sample)?$/",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "dotenvlens.compare",
          "when": "resourceFilename =~ /^\\.env(\\.local|\\.template|\\.example|\\.sample)?$/",
          "group": "navigation@100"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "npm run package",
    "vsce:package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
